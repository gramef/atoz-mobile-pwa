{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.2.3",
        "barryvdh/laravel-cors": "^0.11.2",
        "doctrine/dbal": "^2.9",
        "fideloper/proxy": "^4.0",
        "guzzlehttp/guzzle": "*",
        "laravel/framework": "5.7.*",
        "laravel/tinker": "^1.0",
        "laravelcollective/html": "^5.4.0",
        "league/flysystem-aws-s3-v3": "^1.0",
        "maatwebsite/excel": "^3.1",
        "mailgun/mailgun-php": "*",
        "php-http/message-factory": "^1.1",
        "phpmailer/phpmailer": "^6.9",
        "sentry/sentry-laravel": "1.0.2",
        "spatie/laravel-permission": "^2.27",
        "swiftmailer/swiftmailer": "^6.0",
        "symfony/dom-crawler": "^4.2",
        "symfony/mailer": "^5.4"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.2",
        "beyondcode/laravel-dump-server": "^1.0",
        "filp/whoops": "^2.0",
        "fzaninotto/faker": "^1.4",
        "mockery/mockery": "^1.0",
        "nunomaduro/collision": "^2.0",
        "phpunit/phpunit": "^7.0",
        "mpdf/mpdf": "^8.2"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "kylekatarnls/update-helper": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "*"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Carbon\\": "app/Overrides/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-install-cmd": [
            "rm -rf vendor/mpdf/mpdf/ttfonts",
            "rm -rf vendor/aws/aws-sdk-php/src/data",
            "rm -rf vendor/fzaninotto/faker/src/Faker/Provider/zh_TW",
            "rm -rf vendor/fzaninotto/faker/src/Faker/Provider/zh_CN",
            "rm -rf vendor/fzaninotto/faker/src/Faker/Provider/ja_JP",
            "rm -rf vendor/fzaninotto/faker/src/Faker/Provider/ko_KR",
            "rm -rf vendor/fzaninotto/faker/src/Faker/Provider/hy_AM",
            "rm -rf vendor/fzaninotto/faker/src/Faker/Provider/el_GR",
            "rm -rf vendor/fzaninotto/faker/src/Faker/Provider/he_IL",
            "rm -rf vendor/fzaninotto/faker/src/Faker/Provider/ka_GE",
            "rm -rf vendor/fzaninotto/faker/src/Faker/Provider/kk_KZ",
            "rm -rf vendor/fzaninotto/faker/src/Faker/Provider/mn_MN",
            "rm -rf vendor/fzaninotto/faker/src/Faker/Provider/ru_RU",
            "rm -rf vendor/fzaninotto/faker/src/Faker/Provider/uk_UA"
        ],
        "vercel": [
            "rm -rf vendor/mpdf/mpdf/ttfonts",
            "rm -rf vendor/aws/aws-sdk-php/src/data",
            "rm -rf vendor/fzaninotto/faker/src/Faker/Provider/zh_TW",
            "rm -rf vendor/fzaninotto/faker/src/Faker/Provider/zh_CN",
            "rm -rf vendor/fzaninotto/faker/src/Faker/Provider/ja_JP",
            "rm -rf vendor/fzaninotto/faker/src/Faker/Provider/ko_KR",
            "rm -rf vendor/fzaninotto/faker/src/Faker/Provider/hy_AM",
            "rm -rf vendor/fzaninotto/faker/src/Faker/Provider/el_GR",
            "rm -rf vendor/fzaninotto/faker/src/Faker/Provider/he_IL",
            "rm -rf vendor/fzaninotto/faker/src/Faker/Provider/ka_GE",
            "rm -rf vendor/fzaninotto/faker/src/Faker/Provider/kk_KZ",
            "rm -rf vendor/fzaninotto/faker/src/Faker/Provider/mn_MN",
            "rm -rf vendor/fzaninotto/faker/src/Faker/Provider/ru_RU",
            "rm -rf vendor/fzaninotto/faker/src/Faker/Provider/uk_UA"
        ]
    }
}

{
  "version": 2,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "excludeFiles": "{vendor/aws/aws-sdk-php/src/data/**,vendor/mpdf/mpdf/ttfonts/**}"
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.php"
    }
  ]
}
